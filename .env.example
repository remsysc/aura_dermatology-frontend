# Base URL of the AURA Laravel API (include /api/v1, no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Active consent notice versions. The API validates these against `consent_notices`;
# it does not (yet) expose an endpoint to read the current booking version.
NEXT_PUBLIC_BOOKING_CONSENT_VERSION=2026-10-v1

# Cloudflare Turnstile site key. Required in production (the API rejects missing
# tokens there). Leave empty locally: the API bypasses Turnstile in local/testing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PayMongo Public Key (pk_test_... or pk_live_...). Used in the browser for checkout.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=

# Canonical site URL (e.g. https://aura.ph) for sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dynamic clinic details shown in the footer, confirmations, and privacy policy (defaults applied if unset).
NEXT_PUBLIC_CLINIC_NAME=AURA Dermatology & Laser Studio
NEXT_PUBLIC_CLINIC_ADDRESS=Unit 1402, High Street South Corporate Plaza Tower 1, 26th St. cor. 9th Ave., Bonifacio Global City, Taguig, 1634 Metro Manila
NEXT_PUBLIC_CLINIC_PHONE=+63 (2) 8812-2872
NEXT_PUBLIC_CLINIC_EMAIL=concierge@aura.ph
